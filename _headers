/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # HSTS is managed in the Netlify dashboard (Domain management > HTTPS), not here:
  # Netlify already sends Strict-Transport-Security: max-age=31536000, and a
  # duplicate header from _headers would make browsers drop it entirely (RFC 6797).
  # Strict CSP: no unsafe-inline/unsafe-eval. The single inline script (theme
  # no-flash detector in <head>) is allowed by hash - regenerate with `npm run hash`
  # whenever js/theme-init.js changes. The site-kit analytics/consent files load
  # from 'self'; the GA/GTM origins below are required by site-kit/rsa-analytics.js
  # (Phase A: GA4 + Consent Mode v2).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-1F9N9BrrKBVMMcPvcgckSbkfN2UUKzJnS4P4m+CZmLo=' https://www.googletagmanager.com; style-src 'self'; img-src 'self' https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

/images/*
  Cache-Control: public, max-age=604800

/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800
